# Server
PORT=3870
NODE_ENV=development
# ใช้เซ็น cookie ของลูกค้าและ token ของ admin — ตั้งค่าใหม่ก่อนขึ้น production
JWT_SECRET=change-me-order-jianchatea

# บัญชีหลังบ้าน (/admin-page) เก็บในฐานข้อมูล ครั้งแรกระบบสร้างให้ 3 บัญชี:
#   it-admin / jiancha2026 (IT-Admin ทำได้ทุกอย่าง)  admin / marketing (ดูออเดอร์)  finance / jiancha (ตรวจสลิป)
# เปลี่ยนรหัสผ่านได้ในหน้า Account ของ IT-Admin ก่อนขึ้น production

# PromptPay ที่รับเงิน (เบอร์โทร / เลขนิติบุคคล / e-wallet id)
PROMPTPAY_ID=
# ถ้ามี payload ของ Thai-QR ร้านค้า (จาก QR ที่พิมพ์ไว้) ใส่ตรงนี้ ระบบจะใส่ยอดเงินให้อัตโนมัติ
PROMPTPAY_QR_PAYLOAD=

# SlipOK (ตรวจสลิปอัตโนมัติ) — ว่างไว้ = สลิปทุกใบจะรอ admin ตรวจเอง
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=

# Sign in with Google (ลูกค้าต้องล็อกอินก่อนกด Confirm) — OAuth 2.0 Client ID ชนิด Web application
# สร้างที่ https://console.cloud.google.com/apis/credentials แล้วใส่ Authorized JavaScript origins:
#   https://order.jianchatea.com และ http://localhost:3870 (ไม่ต้องใส่ redirect URI)
# ว่างไว้ = ปิด login ลูกค้าสั่งซื้อได้โดยไม่ต้องล็อกอินเหมือนเดิม
GOOGLE_CLIENT_ID=

# ที่อยู่เว็บสำหรับสร้างลิงก์ (ใช้ในหน้า admin)
PUBLIC_BASE_URL=https://order.jianchatea.com

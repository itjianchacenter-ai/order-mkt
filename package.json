{
  "name": "jiancha-order",
  "version": "0.1.0",
  "description": "JIANCHA x NAVORI pre-order website (order.jianchatea.com)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node scripts/smoke-test.js",
    "test:cf": "node scripts/test-cf.js",
    "build:site": "bash scripts/build-site.sh",
    "dev:cf": "SITE_MODE=real bash scripts/build-site.sh && npx wrangler pages dev _site --d1 DB=jc-order --r2 FILES=jc-files --compatibility-date=2026-09-01 --binding JWT_SECRET=dev --binding PROMPTPAY_ID=0812345678"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "form-data": "^4.0.5",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.10.1",
    "promptpay-qr": "^0.5.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "wrangler": "^4.132.0",
    "esbuild": "^0.28.1"
  }
}
